# Python and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.ipynb_checkpoints/

# Generated runs and large artifacts. Keep summaries/config/splits under docs/ or configs/.
/runs/
/artifacts/
/logs/
/checkpoints/
/models/
/out/
/outputs/
/mlruns/
/mlartifacts/
/wandb/
/tensorboard/
/data/downloads/
/data/cache/
/data/processed/
/.cache/

# Local runtime files; existing tracked files are unaffected.
*.log
*.tmp
*.swp
.DS_Store
.env
.env.*
!.env.example

# Do not blanket-ignore JSON, JSONL, CSV or all data: small metrics and split
# manifests belong in version control. Existing tracked data/outputs stay tracked.

# Authentication state stays outside Git, including accidental local copies.
/.local-state/
/.auth/
/browser-profile/
/playwright/.auth/
