  "rules": {
    "quote_support": "Frozen patient_set.literal_positions: exact case-sensitive original segment, whole word boundary. No inference from marker-inserted text.",
    "dictionary_normalization": "Casefold and collapse consecutive whitespace to one space, strip edges; no stemming, punctuation deletion, fuzzy match, substring alias, or model.",
